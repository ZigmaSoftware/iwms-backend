# ==========================================================
# IWMS Backend — .gitignore
# See README.md § Environment variables before adding secrets.
# ==========================================================

# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.pyd

# === Django migrations (generated on each machine — see README) ===
# 0001_initial.py is a huge, machine-generated snapshot every environment
# quietly regenerates for itself against whatever models.py looks like at
# the time — never shared, never diffed. That means two environments can
# both show "0001_initial applied" while their real table schemas have
# drifted apart, since Django only compares migration NAMES, never content.
# A schema change that must ship everywhere (production included) gets its
# own small, committed migration instead — hence the exception below.
**/migrations/*
!**/migrations/__init__.py
!app/migrations/0002_employee_face_embedding.py
!app/migrations/0003_wastecollection_image.py

# === Virtual environments ===
venv/
env/
.venv/

# === Django static / media ===
# `static/` is the SOURCE of static assets and IS tracked in git.
# `staticfiles/` is collectstatic OUTPUT — regenerate it, never commit it.
media/
staticfiles/

# === Environment files (NEVER commit — see .env.example) ===
.env
.env.*
!.env.example

# === Logs and local databases ===
*.log
db.sqlite3
*.sqlite3

# === Tests and coverage output ===
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# === Build and dist ===
build/
dist/
*.egg-info/

# === Per-machine and deploy artefacts (not shared) ===
backend_sync.sh
cron.sh
*.deb

# === IDE and OS files ===
.vscode/
.idea/
.DS_Store
Thumbs.db
